{
	"name": "@contactwise/n8n-nodes-contactwise",
	"version": "0.1.0",
	"description": "n8n nodes for the ContactWise messaging API: send DLT-compliant SMS to Indian mobile numbers",
	"license": "MIT",
	"homepage": "https://github.com/ContactWise/n8n-nodes-contactwise#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"contactwise",
		"sms",
		"dlt",
		"india"
	],
	"author": {
		"name": "ContactWise",
		"email": "lakshmikanth@contactwise.io"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/ContactWise/n8n-nodes-contactwise.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"dev:docker": "n8n-node build && sh scripts/dev-docker.sh",
		"dev:docker:logs": "docker logs -f n8n-contactwise-dev",
		"dev:docker:stop": "docker rm -f n8n-contactwise-dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"typecheck": "tsc -p tsconfig.test.json",
		"format": "prettier --write \"nodes/**/*.ts\" \"credentials/**/*.ts\" \"test/**/*.ts\"",
		"format:check": "prettier --check \"nodes/**/*.ts\" \"credentials/**/*.ts\" \"test/**/*.ts\"",
		"test": "vitest run",
		"test:watch": "vitest",
		"check:deps": "node -e \"const p=require('./package.json');const bad=Object.keys({...p.dependencies,...p.optionalDependencies}).concat(Object.keys(p.peerDependencies||{}).filter(n=>n!=='n8n-workflow'));if(bad.length){console.error('Runtime dependencies are not allowed: '+bad.join(', '));process.exit(1)}\"",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/ContactWiseApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/ContactWiseSms/ContactWiseSms.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"@vitest/coverage-v8": "5.0.1",
		"eslint": "9.32.0",
		"n8n-core": "2.40.3",
		"n8n-workflow": "2.40.1",
		"nock": "14.0.17",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2",
		"vitest": "5.0.1",
		"vitest-mock-extended": "5.1.1"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
